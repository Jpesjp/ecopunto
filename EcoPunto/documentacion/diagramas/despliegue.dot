digraph Despliegue {
  graph [rankdir=TB, splines=polyline, nodesep=0.7, ranksep=1.3, fontname="Helvetica", bgcolor="white", label="Diagrama de Despliegue - EcoPunto", labelloc=t, fontsize=20];
  node [fontname="Helvetica", fontsize=11, shape=box, style="filled", fillcolor="#F4F9F4", color="#2E7D32", penwidth=1.6];
  edge [fontname="Helvetica", fontsize=10, color="#37474F", penwidth=1.3];

  subgraph cluster_cliente {
    label="<<device>> Dispositivo Cliente\n(PC / Tablet / Smartphone)";
    fontsize=12; fontname="Helvetica-Bold"; color="#1B5E20"; style="rounded,dashed"; bgcolor="#FAFDFA";
    nav [label="<<execution environment>>\nNavegador Web\nChrome / Firefox / Edge\n\nHTML5 + CSS3 + Bootstrap 5"];
  }

  subgraph cluster_app {
    label="<<server>> Servidor de Aplicaciones\nUbuntu Server 22.04 LTS";
    fontsize=12; fontname="Helvetica-Bold"; color="#1B5E20"; style="rounded,dashed"; bgcolor="#FAFDFA";
    nginx [label="<<execution environment>>\nNginx 1.24\n(Servidor web / proxy inverso)"];
    gunicorn [label="<<execution environment>>\nGunicorn 21.2 (WSGI)"];
    app [label="<<artifact>>\napp.py - EcoPunto\nPython 3.12 + Flask 3.0\nPatrón MVC", fillcolor="#E8F5E9"];
    api [label="<<artifact>>\nAPI REST /api/v1\nJSON - Arquitectura REST", fillcolor="#E8F5E9"];
    nginx -> gunicorn [label="  WSGI"];
    gunicorn -> app [label="  invoca"];
    app -> api [label="  expone", style=dashed];
  }

  subgraph cluster_bd {
    label="<<server>> Servidor de Base de Datos";
    fontsize=12; fontname="Helvetica-Bold"; color="#1B5E20"; style="rounded,dashed"; bgcolor="#FAFDFA";
    smgbd [label="<<execution environment>>\nSGBD Relacional\nSQLite 3.45 / MySQL 8.0"];
    db [label="<<database>>\necopunto.db\n6 tablas relacionales", shape=cylinder, fillcolor="#E8F5E9"];
    smgbd -> db [label="  persiste"];
  }

  nav -> nginx [label="  HTTPS / TCP-IP  \n  puerto 443  "];
  app -> smgbd [label="  DB-API 2.0 / SQL\n  puerto 3306  ", constraint=false];
}
